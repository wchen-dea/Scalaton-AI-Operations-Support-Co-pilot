# Frontend environment configuration.
# Only src/config/env.ts reads these values; every variable has a default there.
# Grounded in docs/scalaton-technology-architecture.md §10 (frontend-relevant categories).

# Approved API base URL. Same-origin in production; all endpoints derive from this.
VITE_API_BASE_URL=/api

# Data source: "mock" (default, runs without a backend) or "live" (proxied backend).
VITE_API_MODE=mock

# Dev-only: backend origin the Vite dev server proxies /api to in live mode.
VITE_DEV_PROXY_TARGET=http://localhost:8000

# Feature flag for mutating external writes. Disabled by default in dev/test.
VITE_ENABLE_EXTERNAL_WRITES=false
